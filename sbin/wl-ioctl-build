#!/bin/bash
# wl-ioctl-build - rebuild RPM Fusion's broadcom-wl (wl-kmod) for one kernel with
# patches/0001-wl-add-ndo_siocdevprivate.patch, and install it as
# /lib/modules/<kver>/updates/wl.ko, which takes precedence over akmods' extra/wl.
#
#   wl-ioctl-build [KERNEL_VERSION]      (default: the running kernel)
#
# Source: the wl-kmod SRPM that akmod-wl keeps in /usr/src/akmods, so every
# RPM Fusion update (new kernel adaptations) is picked up automatically.
#
# SPDX-License-Identifier: MIT
set -euo pipefail

KVER=${1:-$(uname -r)}
SRPM=${WL_SRPM:-$(readlink -f /usr/src/akmods/wl-kmod.latest 2>/dev/null || true)}
PATCH=${WL_IOCTL_PATCH:-/usr/local/share/wl-ioctl/0001-wl-add-ndo_siocdevprivate.patch}
JOBS=${JOBS:-2}

die() { echo "wl-ioctl-build: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"
[ -n "$SRPM" ] && [ -f "$SRPM" ] || die "wl-kmod SRPM not found (is akmod-wl from RPM Fusion installed?)"
[ -f "$PATCH" ] || die "patch not found: $PATCH"
KDIR=/usr/src/kernels/$KVER
[ -d "$KDIR" ] || KDIR=/lib/modules/$KVER/build
[ -d "$KDIR" ] || die "kernel headers for $KVER not found (install kernel-devel-$KVER)"
for t in rpm2cpio cpio patch make gcc; do command -v "$t" >/dev/null || die "missing tool: $t"; done

WORK=$(mktemp -d /var/tmp/wl-ioctl-build.XXXXXX)
cleanup() { case "$WORK" in /var/tmp/wl-ioctl-build.*) rm -rf -- "$WORK" ;; esac; }
trap cleanup EXIT

cd "$WORK"
rpm2cpio "$SRPM" | cpio -idm --quiet
case "$(uname -m)" in
  x86_64) TARBALL=$(ls hybrid-v35_64-nodebug-pcoem-*.tar.gz) ;;
  *)      TARBALL=$(ls hybrid-v35-nodebug-pcoem-*.tar.gz) ;;
esac
mkdir src
tar -C src -xzf "$TARBALL"

# Apply RPM Fusion's patches in the same order as the spec (%patch -P 0, 1, 2, ...).
awk '/^Patch[0-9]+:/ { n = $1; gsub(/[^0-9]/, "", n); print n, $2 }' wl-kmod.spec |
  sort -n | while read -r _ p; do
    patch -d src -s -p1 < "$p" || die "RPM Fusion patch failed: $p"
  done

patch -d src -s -p1 --dry-run < "$PATCH" >/dev/null ||
  die "our patch no longer applies to $(basename "$SRPM"); see README (Troubleshooting)"
patch -d src -s -p1 < "$PATCH"

nice -n 10 make -s -j"$JOBS" -C "$KDIR" M="$WORK/src" modules >/dev/null
install -D -m 644 src/wl.ko "/lib/modules/$KVER/updates/wl.ko"
command -v restorecon >/dev/null && restorecon -R "/lib/modules/$KVER/updates" || true
depmod -a "$KVER"
echo "$(date -Is) wl with ioctl hook installed for $KVER (from $(basename "$SRPM"))"
